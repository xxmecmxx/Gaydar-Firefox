{
  "manifest_version": 3,
  "name": "Gaydar",
  "version": "1.2",
  "description": "Hides specific cigar brands on CigarPage.com and adds additional search functionality.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cigarpage-brand-blocker@local.addon",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manage Blocked Brands & SKUs"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
